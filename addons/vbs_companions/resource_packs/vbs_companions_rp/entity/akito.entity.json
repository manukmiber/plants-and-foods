{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "vbs:akito",
      "min_engine_version": "1.21.0",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/vbs_companions/akito"
      },
      "geometry": {
        "default": "geometry.vbs_companion.akito"
      },
      "animations": {
        "look_at_target": "animation.vbs_companion.look_at_target",
        "idle": "animation.vbs_companion.idle",
        "walk": "animation.vbs_companion.walk",
        "hair": "animation.vbs_companion.hair",
        "detail": "animation.vbs_companion.detail",
        "harvest": "animation.vbs_companion.harvest",
        "mine": "animation.vbs_companion.mine",
        "build": "animation.vbs_companion.build",
        "combat": "animation.vbs_companion.combat",
        "aim": "animation.vbs_companion.aim",
        "talk": "animation.vbs_companion.talk",
        "greet": "animation.vbs_companion.greet"
      },
      "scripts": {
        "animate": [
          "look_at_target",
          "idle",
          "walk",
          "hair",
          "detail",
          {
            "harvest": "query.property('vbs:pose') == 1"
          },
          {
            "mine": "query.property('vbs:pose') == 3"
          },
          {
            "build": "query.property('vbs:pose') == 4"
          },
          {
            "combat": "query.property('vbs:pose') == 5"
          },
          {
            "aim": "query.property('vbs:pose') == 6"
          },
          {
            "talk": "query.property('vbs:pose') == 7"
          },
          {
            "greet": "query.property('vbs:pose') == 2"
          }
        ],
        "initialize": [
          "variable.vbs_face = 0;"
        ],
        "pre_animation": [
          "variable.vbs_face = (query.property('vbs:face') > 0) ? (query.property('vbs:face') - 1) : ((query.hurt_time > 0) ? 5 : ((query.property('vbs:pose') == 5 || query.property('vbs:pose') == 6) ? 4 : ((!query.is_on_ground) ? 4 : ((query.property('vbs:pose') == 1 || query.property('vbs:pose') == 3 || query.property('vbs:pose') == 4) ? 3 : ((math.mod(query.life_time, 4.6) < 0.16) ? 1 : ((query.modified_move_speed > 0.86) ? 7 : ((query.modified_move_speed > 0.08) ? 3 : ((math.mod(query.life_time, 37) < 2.4 && query.modified_move_speed < 0.02) ? 6 : ((math.mod(query.life_time, 13) < 2.2) ? 2 : 0)))))))));"
        ]
      },
      "render_controllers": [
        "controller.render.vbs_companion.akito"
      ],
      "spawn_egg": {
        "texture": "vbs_spawn_egg_akito",
        "texture_index": 0
      },
      "enable_attachables": false
    }
  }
}
